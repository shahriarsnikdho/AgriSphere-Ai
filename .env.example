# Copy to .env.local. NEVER commit real values.

# --- Public (safe for the browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only secrets (never prefix with NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Diagnosis provider ---
# "mock" returns clearly labelled DEMO data. "http" calls the inference service.
DIAGNOSIS_PROVIDER=mock
DIAGNOSIS_API_URL=
DIAGNOSIS_API_KEY=
